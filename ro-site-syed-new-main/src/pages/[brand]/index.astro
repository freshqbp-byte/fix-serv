---
import Layout from '@/layouts/Layout.astro';
import { BrandPageLayout } from '@/components/BrandPageLayout';
import { BRAND_PAGES_DATA, BUSINESS_DETAILS } from '@/data/content';
import type { BrandInfo } from '@/types';

export async function getStaticPaths() {
  const brands = Object.values(BRAND_PAGES_DATA);
  const paths = [];

  for (const brand of brands) {
    const key = brand.slug.replace(/^\//, '');
    paths.push({
      params: { brand: key },
      props: { brand },
    });
    if (brand.id && brand.id !== key) {
      paths.push({
        params: { brand: brand.id },
        props: { brand },
      });
    }
  }

  return paths;
}

const { brand } = Astro.props;

if (!brand) {
  return Astro.redirect('/404');
}

const brandKey = brand.slug.replace(/^\//, '');
const pageUrl = `https://www.roservicesupport.co.in/${brandKey}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${pageUrl}#service`,
    url: pageUrl,
    name: `${brand.name} Water Purifier Repair & Service Bangalore`,
    serviceType: 'Water Purifier Repair, Maintenance & Filter Replacement',
    provider: {
      '@type': 'LocalBusiness',
      '@id': 'https://www.roservicesupport.co.in/#localbusiness',
      name: BUSINESS_DETAILS.name,
      telephone: `+91${BUSINESS_DETAILS.phone}`,
      url: 'https://www.roservicesupport.co.in',
    },
    areaServed: { '@type': 'City', name: 'Bangalore' },
    description: brand.metaDescription,
    offers: {
      '@type': 'Offer',
      priceCurrency: 'INR',
      description: 'Doorstep inspection and diagnosis, 100% adjusted against final repair bill upon approval.',
    },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: '4.8',
      reviewCount: '10480',
      bestRating: '5',
      worstRating: '1',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: brand.brandFaqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];
---

<Layout
  title={brand.metaTitle}
  description={brand.metaDescription}
  canonical={pageUrl}
  ogTitle={brand.metaTitle}
  ogDescription={brand.metaDescription}
  ogUrl={pageUrl}
  ogImage={brand.heroImage}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <BrandPageLayout brand={brand} client:only="react" />
</Layout>